# ── Build stage ──
FROM rust:1.82-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

# Cache the dependency-compile layer separately from source changes — the
# build context is now the shared repo root, so copy explicitly, not `COPY . .`.
COPY ratelimiter/Cargo.toml ratelimiter/Cargo.lock ./
RUN mkdir src && echo "fn main() {}" > src/main.rs && cargo build --release && rm -rf src
COPY ratelimiter/src ./src
RUN touch src/main.rs && cargo build --release

# ── Runtime stage ──
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/dataharvest-ratelimiter /usr/local/bin/ratelimiter

EXPOSE 8090
CMD ["ratelimiter"]
